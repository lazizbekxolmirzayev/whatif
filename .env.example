# Optional. The site runs without any of these.
# Grand Strategy (src/strategy) cloud features: accounts, cloud saves, community scenarios, online multiplayer.
# Only the public anon key belongs here. NEVER put an AI API key in a NEXT_PUBLIC_ variable;
# set ANTHROPIC_API_KEY as a Supabase Edge Function secret instead (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_AI_HISTORIAN=false
# WHATIF backend: SQLite file location (default ./data/whatif.db)
WHATIF_DB_PATH=
